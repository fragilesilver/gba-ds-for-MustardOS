# CMake toolchain for cross-compiling to aarch64 Linux (ROCKNIX)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(TOOLCHAIN_BIN "$ENV{AARCH64_TOOLCHAIN_BIN}" CACHE PATH "dir containing aarch64-linux-gnu-gcc")
set(CMAKE_C_COMPILER ${TOOLCHAIN_BIN}/aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER ${TOOLCHAIN_BIN}/aarch64-linux-gnu-g++)
# AARCH64_CPU: the CPU to build for (cortex-a55: the RG DS's RK3568, ROCKNIX;
# cortex-a53: plain ARMv8.0, every muOS device: scripts/build-muos.sh)
set(AARCH64_CPU "$ENV{AARCH64_CPU}")
if(NOT AARCH64_CPU)
  set(AARCH64_CPU cortex-a55)
endif()
set(CMAKE_C_FLAGS_INIT "-mcpu=${AARCH64_CPU}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH ${TOOLCHAIN_BIN}/../aarch64-linux-gnu)
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_FIND_ROOT_PATH}/lib/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")
